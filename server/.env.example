# ---- Servidor ----
NODE_ENV=development
PORT=2567
LOG_LEVEL=info
# Endereço público deste processo (usado quando há vários processos atrás de um balanceador).
# PUBLIC_ADDRESS=game-1.huambo.example.com

# ---- Escalabilidade (opcional) ----
# Quando definido, ativa RedisPresence + RedisDriver (vários processos partilham o matchmaking).
# REDIS_URL=redis://127.0.0.1:6379

# ---- Supabase (opcional em desenvolvimento) ----
# SUPABASE_URL=https://xxxx.supabase.co
# Chave secreta (service_role / sb_secret_...). NUNCA a coloques no cliente.
# SUPABASE_SERVICE_ROLE_KEY=
# Apenas para projetos com segredo JWT legado (HS256). Projetos novos usam JWKS automaticamente.
# SUPABASE_JWT_SECRET=

# ---- Convidados (desenvolvimento / testes) ----
ALLOW_GUESTS=true
# Segredo para assinar tokens de convidado (mín. 32 caracteres). Obrigatório se ALLOW_GUESTS=true em produção.
GUEST_TOKEN_SECRET=dev-only-guest-secret-change-me-0123456789

# ---- Rede / proteção ----
# Cabeçalho de IP real: "cf-connecting-ip" atrás do Cloudflare; vazio = IP do socket.
TRUSTED_IP_HEADER=
# Origens permitidas para o cliente Web (CSV). "*" apenas em desenvolvimento.
CORS_ORIGINS=*
GUEST_RATE_PER_MIN=5
